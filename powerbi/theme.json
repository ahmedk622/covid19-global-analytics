{
  "name": "Covid Analytics",
  "dataColors": ["#1F3A5F", "#A33B32", "#2F6F4F", "#C98B2B", "#6B7F99", "#8A6FA8", "#9DB4D3", "#B8B8B8"],
  "background": "#FFFFFF",
  "foreground": "#262626",
  "tableAccent": "#1F3A5F",
  "good": "#2F6F4F",
  "neutral": "#C98B2B",
  "bad": "#A33B32",
  "maximum": "#1F3A5F",
  "center": "#E9EDF3",
  "minimum": "#FFFFFF",
  "textClasses": {
    "callout": {"fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F3A5F"},
    "title": {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#262626"},
    "header": {"fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#262626"},
    "label": {"fontSize": 10, "fontFace": "Segoe UI", "color": "#595959"}
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{"show": true, "fontColor": {"solid": {"color": "#262626"}}, "fontSize": 11, "fontFamily": "Segoe UI Semibold", "alignment": "left"}],
        "border": [{"show": false}],
        "background": [{"show": false}],
        "dropShadow": [{"show": false}],
        "valueAxis": [{"gridlineColor": {"solid": {"color": "#E5E5E5"}}, "showAxisTitle": false}],
        "categoryAxis": [{"showAxisTitle": false}]
      }
    }
  }
}
